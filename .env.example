# ---- Fast path LLM -----------------------------------------------------------
# groq | openai | fake (deterministic local model, no network; for tests/benchmarks)
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_xxx
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=sk-xxx
OPENAI_MODEL=gpt-4o-mini

# Spring AI service (OpenAI-compatible base URL; Groq by default)
LLM_BASE_URL=https://api.groq.com/openai
LLM_API_KEY=${GROQ_API_KEY}
LLM_MODEL=llama-3.3-70b-versatile

# ---- Vapi / voice providers ------------------------------------------------
VAPI_API_KEY=xxx
DEEPGRAM_API_KEY=xxx
CARTESIA_API_KEY=xxx
ELEVENLABS_API_KEY=

# ---- Slow path (n8n) --------------------------------------------------------
# Where the fast-path services POST turn events (inside the compose network)
N8N_WEBHOOK_URL=http://n8n:5678/webhook/call-event
# Public URL Vapi uses for serverUrl callbacks (ngrok/LB in front of :5678)
N8N_PUBLIC_URL=http://localhost:5678/
N8N_ENCRYPTION_KEY=change-me-please

# Integrations used by the n8n templates. Defaults point at the local mocks.
CRM_BASE_URL=http://langgraph-fastpath:8000/mock/crm
TWILIO_MOCK_URL=http://langgraph-fastpath:8000/mock/twilio/Messages.json
TWILIO_FROM_NUMBER=+15005550006
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# ---- Postgres ----------------------------------------------------------------
POSTGRES_PASSWORD=voiceai
